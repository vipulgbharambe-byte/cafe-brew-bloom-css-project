# Copy this file to .env and update the values before use.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Replace this development-only value with a long random secret before deployment.
SESSION_SECRET=local-only-change-this-to-a-random-secret-at-least-32-characters

# Local administrator account. Change the password before deployment.
ADMIN_EMAIL=admin@cafebrewbloom.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Razorpay TEST credentials first. Live credentials must only be enabled after testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional OpenAI-compatible chat completion endpoint. The menu-only FAQ works without it.
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=

# Google OAuth and production SMS OTP are not enabled until provider callbacks / SMS service are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
